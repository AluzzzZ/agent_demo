LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=deepseek-v4-pro
AGENT_DB_PATH=data/agent.db
AGENT_TRACE_PATH=data/traces.jsonl
AGENT_MAX_ITERATIONS=8
AGENT_WEB_HOST=127.0.0.1
AGENT_WEB_PORT=8765

# 两个本地演示账户；首次启动及每次重启时按这里的值同步。
DEMO_USER_1_USERNAME=zsw1
DEMO_USER_1_PASSWORD=123456
DEMO_USER_1_DISPLAY_NAME=zsw1
DEMO_USER_2_USERNAME=zsw2
DEMO_USER_2_PASSWORD=123456
DEMO_USER_2_DISPLAY_NAME=zsw2

# Search 使用 Wikipedia/MediaWiki，Weather 使用 Open-Meteo；均无需 API Key。

# Optional Anthropic provider:
# ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_MODEL=claude-sonnet-4-6
